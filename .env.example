# Copy this file to .env.local and fill in the values. .env.local is ignored by
# git and must never be committed.

# Supabase > Project Settings > API Keys. These two are public by design: row
# level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase > Project Settings > API Keys > Secret keys.
# SERVER ONLY. Lets admins create team accounts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
